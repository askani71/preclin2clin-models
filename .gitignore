# --- Data (never commit raw clinical / proprietary preclinical data) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# --- Model binaries ---
models/*
!models/.gitkeep
*.pkl
*.joblib
*.rds
*.pt
*.pth
*.onnx

# --- Secrets ---
.env
*.env
secrets/
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage
htmlcov/

# --- R ---
.Rhistory
.RData
.Rproj.user/
renv/library/
renv/staging/
renv/local/
*_cache/
*_files/

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/
